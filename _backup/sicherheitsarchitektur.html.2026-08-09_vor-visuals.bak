<!-- Schriften werden lokal ausgeliefert (Self-Hosting, DSGVO-konform) -->
<link rel="preload" as="font" type="font/woff2" href="assets/fonts/inter-latin-400-normal.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="assets/fonts/playfair-display-latin-400-normal.woff2" crossorigin>
<link rel="stylesheet" href="assets/fonts/fonts.css">

<style>
  :root {
    --navy-900: #0a1628;
    --navy-800: #0f1d33;
    --navy-700: #152540;
    --navy-600: #1c3050;
    --navy-500: #2a4163;
    --black:    #050a14;
    --white:    #ffffff;
    --off-white: #f4f6fa;
    --gray-300: #b8c2d0;
    --gray-400: #8a96a8;
    --gray-500: #5a6578;
    --line:     rgba(255, 255, 255, .1);
    --line-light: rgba(255, 255, 255, .06);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    background: var(--navy-900);
    color: var(--off-white);
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    font-size: 16px;
  }
  body::before {
    content: "";
    position: fixed; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse 100% 80% at 50% 0%, rgba(28, 48, 80, .4), transparent 60%),
      radial-gradient(ellipse 80% 60% at 100% 100%, rgba(15, 29, 51, .6), transparent 60%);
    pointer-events: none;
  }
  body > * { position: relative; z-index: 1; }
  h1, h2, h3, h4 { font-weight: 400; letter-spacing: -0.02em; line-height: 1.15; color: var(--white); }
  .serif { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-weight: 400; }
  a { color: var(--white); text-decoration: none; transition: opacity .2s; }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 48px; }

  /* ===== HEADER (von der Startseite übernommen) ===== */
  header.site {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(10, 22, 40, .8);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line-light);
  }
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 48px; max-width: 1280px; margin: 0 auto;
  }
  .brand { display: flex; align-items: center; gap: 14px; color: var(--white); }
  .brand-logo {
    width: 44px; height: 44px; border: 1px solid rgba(255,255,255,.18);
    background: var(--white); display: grid; place-items: center; overflow: hidden; flex-shrink: 0;
  }
  .brand-logo img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .brand-text .title { font-size: 15px; font-weight: 500; letter-spacing: -0.01em; }
  .brand-text .sub { font-size: 11px; color: var(--gray-400); letter-spacing: .14em; text-transform: uppercase; margin-top: 2px; }
  nav.primary ul { list-style: none; display: flex; gap: 36px; align-items: center; }
  nav.primary a { color: var(--off-white); font-size: 14px; font-weight: 400; opacity: .75; transition: opacity .2s; }
  nav.primary a:hover { opacity: 1; }
  nav.primary a[aria-current="page"] { opacity: 1; }
  .nav-cta {
    margin-left: 8px; background: var(--white); color: var(--navy-900) !important;
    padding: 10px 22px; font-size: 13px; font-weight: 500; opacity: 1 !important; transition: background .2s;
  }
  .nav-cta:hover { background: var(--off-white); }
  .nav-toggle {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 44px; height: 44px; padding: 10px; background: transparent;
    border: 1px solid rgba(255,255,255,.18); cursor: pointer; z-index: 110;
  }
  .nav-toggle span { display: block; width: 100%; height: 2px; background: var(--white); transition: transform .3s ease, opacity .3s ease; }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ===== BUTTONS ===== */
  .btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 16px 28px; font-size: 14px; font-weight: 500;
    cursor: pointer; border: 1px solid transparent;
    text-decoration: none; transition: all .25s; letter-spacing: .01em; font-family: inherit;
  }
  .btn-primary { background: var(--white); color: var(--navy-900); }
  .btn-primary:hover { background: var(--off-white); color: var(--navy-900); }
  .btn-ghost { background: transparent; color: var(--white); border-color: rgba(255,255,255,.25); }
  .btn-ghost:hover { border-color: var(--white); background: rgba(255,255,255,.05); color: var(--white); }
  .btn .arrow { transition: transform .25s; font-size: 16px; }
  .btn:hover .arrow { transform: translateX(4px); }

  /* ===== SEITENKOPF ===== */
  main { padding-top: 92px; }
  .p-hero { padding: 72px 0 56px; }
  .p-back { display: flex; width: max-content; max-width: 100%; align-items: center; gap: 8px; font-size: 13px; color: var(--gray-400); margin-bottom: 30px; }
  .p-back:hover { color: var(--white); }
  .p-eyebrow {
    display: inline-flex; align-items: center; gap: 12px; font-size: 12px;
    letter-spacing: .14em; text-transform: uppercase; color: var(--gray-300); margin-bottom: 26px;
  }
  .p-eyebrow::before { content: ""; width: 32px; height: 1px; background: var(--gray-400); }
  .p-hero h1 {
    font-weight: 300; font-size: clamp(36px, 5.4vw, 60px);
    line-height: 1.08; letter-spacing: -0.025em; margin-bottom: 26px;
  }
  .p-lead { font-size: clamp(17px, 1.6vw, 20px); line-height: 1.65; color: var(--gray-300); font-weight: 300; max-width: 62ch; }
  .p-section { padding: 0 0 100px; }

  /* ===== ARCHITEKTUR (von der Startseite übernommen) ===== */
  .arch-sub { margin: 0 0 40px; max-width: 760px; }
  .arch-sub .arch-kicker { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--gray-400); margin-bottom: 20px; }
  .arch-sub h2 {
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 300; letter-spacing: -.02em; line-height: 1.15; margin-bottom: 18px;
  }
  .arch-sub p { color: var(--gray-300); font-size: 16px; line-height: 1.65; font-weight: 300; }
  .arch-paths { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 28px; }
  .arch-path {
    background: var(--navy-700); border: 1px solid var(--line);
    padding: 48px 44px; position: relative; transition: border-color .25s, background .25s;
  }
  .arch-path:hover { border-color: rgba(255,255,255,.25); background: var(--navy-600); }
  .arch-path .pt { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--gray-400); margin-bottom: 20px; }
  .arch-path h3 { font-size: 23px; font-weight: 400; letter-spacing: -.02em; line-height: 1.2; margin-bottom: 16px; }
  .arch-path > p { color: var(--gray-300); font-size: 15px; line-height: 1.6; font-weight: 300; margin-bottom: 24px; }
  .arch-list { list-style: none; padding-top: 22px; border-top: 1px solid var(--line); }
  .arch-list li {
    padding: 11px 0; font-size: 14px; color: var(--off-white);
    display: flex; gap: 14px; align-items: start; border-bottom: 1px solid var(--line-light);
  }
  .arch-list li:last-child { border-bottom: 0; }
  .arch-list li::before { content: ""; width: 14px; height: 1px; background: var(--gray-400); margin-top: 11px; flex-shrink: 0; }
  .arch-list li strong { color: var(--white); font-weight: 500; }
  .arch-note {
    border: 1px solid var(--line); background: rgba(255,255,255,.035);
    padding: 26px 30px; font-size: 15px; line-height: 1.65; color: var(--gray-300); font-weight: 300;
  }
  .arch-note strong { color: var(--white); font-weight: 500; }
  .arch-diagram { margin: 0 0 28px; background: var(--navy-700); border: 1px solid var(--line); padding: 30px 30px 26px; }
  .arch-diagram .ad-ttl { color: var(--white); font-weight: 500; font-size: 16px; margin-bottom: 5px; }
  .arch-diagram .ad-sub { color: var(--gray-400); font-size: 13.5px; line-height: 1.55; margin-bottom: 20px; max-width: 78ch; }
  .arch-diagram svg { width: 100%; height: auto; display: block; }
  .eff-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .eff { border-top: 1px solid var(--white); padding-top: 34px; }
  .eff-num { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--gray-400); margin-bottom: 26px; }
  .eff h3 { font-size: 22px; font-weight: 400; margin-bottom: 16px; line-height: 1.2; letter-spacing: -.02em; }
  .eff p { color: var(--gray-300); font-size: 15px; line-height: 1.6; font-weight: 300; }

  .p-divider { height: 1px; background: var(--line); margin: 96px 0 80px; }

  /* ===== CTA ===== */
  .cta-box {
    background: var(--navy-800); border: 1px solid var(--line);
    padding: 48px 44px; box-shadow: 0 30px 60px -30px rgba(0,0,0,.6);
  }
  .cta-box h2 { margin: 0 0 14px; font-weight: 300; font-size: clamp(24px, 3vw, 34px); }
  .cta-box p { color: var(--gray-300); font-size: 16px; font-weight: 300; line-height: 1.65; max-width: 62ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }

  /* ===== FOOTER (von der Startseite übernommen) ===== */
  footer { background: var(--black); padding: 80px 0 40px; border-top: 1px solid var(--line-light); }
  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 56px; padding-bottom: 56px; border-bottom: 1px solid var(--line); }
  .foot-brand .foot-name { font-size: 18px; font-weight: 500; margin-bottom: 6px; }
  .foot-brand .foot-sub { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--gray-400); margin-bottom: 24px; }
  .foot-brand p { font-size: 14px; line-height: 1.65; color: var(--gray-300); max-width: 34ch; font-weight: 300; }
  footer h5 { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--gray-400); margin-bottom: 18px; font-weight: 500; }
  footer ul { list-style: none; }
  footer li { padding: 6px 0; }
  footer a { color: var(--off-white); font-size: 14px; opacity: .8; }
  footer a:hover { opacity: 1; }
  .foot-bottom { padding-top: 32px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 12px; letter-spacing: .04em; color: var(--gray-500); }

  @media (max-width: 1024px) {
    .nav { padding-left: 32px; padding-right: 32px; }
    .container { padding: 0 32px; }
    .eff-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 768px) {
    .nav-toggle { display: inline-flex; }
    nav.primary {
      position: absolute; top: 100%; left: 0; right: 0;
      background: rgba(10, 22, 40, .97); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line-light); max-height: 0; overflow: hidden; visibility: hidden;
      transition: max-height .35s ease, visibility .35s ease;
    }
    nav.primary.is-open { max-height: calc(100vh - 80px); visibility: visible; overflow-y: auto; }
    nav.primary ul { display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 12px 24px 24px; }
    nav.primary ul li { border-bottom: 1px solid var(--line-light); }
    nav.primary ul li:last-child { border-bottom: none; }
    nav.primary a { display: block; padding: 16px 4px; font-size: 16px; opacity: .9; }
    nav.primary .nav-cta { margin: 16px 0 0; text-align: center; padding: 14px 22px; }
    header.site { overflow: visible; }
    .nav { position: relative; padding: 18px 24px; }
    .container { padding: 0 24px; }
    main { padding-top: 76px; }
    .p-hero { padding: 48px 0 40px; }
    .p-section { padding-bottom: 64px; }
    .p-divider { margin: 64px 0 56px; }
    .arch-paths { grid-template-columns: 1fr; gap: 24px; }
    .arch-path { padding: 36px 28px; }
    .arch-diagram { padding: 22px 20px 20px; }
    .cta-box { padding: 32px 24px; }
    .cta-row .btn { width: 100%; justify-content: center; text-align: center; }
    .foot-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
    .foot-bottom { flex-direction: column; gap: 8px; }
  }
  @media (max-width: 480px) {
    .nav { padding: 14px 16px; }
    .container { padding: 0 16px; }
    .arch-path { padding: 28px 22px; }
    .foot-grid { grid-template-columns: 1fr; }
  }
</style>

